# Copy to .env and fill in what you need. .env is never committed.

# --- ElevenLabs (optional: voiceover, Scribe transcription, Voice Isolator) ---
ELEVENLABS_API_KEY=
# 1 = fake ElevenLabs (local test tones, no network, no credits) for development and tests.
ELEVENLABS_MOCK=0

# --- Moment selection LLM: claude_code | anthropic | openai | ollama | heuristic ---
# claude_code (default) uses your Claude Code subscription via the /find-moments slash command.
LLM_PROVIDER=claude_code
# "Run with Claude" button: the Claude Code CLI to call and an optional model for it (empty = your default)
CLAUDE_BIN=claude
CLAUDE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OLLAMA_MODEL=llama3.1
OLLAMA_HOST=http://127.0.0.1:11434

# --- Transcription: tiny | base | small | medium | large-v3 | large-v3-turbo (Settings can override) ---
WHISPER_MODEL=large-v3
# Models are downloaded on first use (large-v3 is ~3 GB) into this folder.
WHISPER_MODELS_DIR=data/models

# --- Compute device: auto | cuda | mps | cpu (Settings can override) ---
DEVICE=auto

# --- Paths (relative paths are resolved from the repo root) ---
DATA_DIR=data
# Override if ffmpeg/ffprobe are not on PATH
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
